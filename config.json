{
  "ingestion": {
    "loader": "pymupdf4llm",           
    "pdf_dir": "data/raw/pdfs",
    "max_pdfs": 1000,
    "log_dir": "logs",
    "stats_dir": "logs"
  },
  "chunking": {
    "strategy": "section",
    "chunk_size": 512,
    "chunk_overlap": 100
  },
  "embeddings": {
      "model_name": "nomic-embed-text",
      "base_url": "http://localhost:11434",
      "batch_size": 32
  },
  "retrieval": {
    "top_k": 5,
    "collection_name": "rag_chunks",
    "use_hybrid": false,
    "bm25_index_path": "data/vector_store/bm25_index.pkl",
    "use_rerank": false,
    "rerank_model": "BAAI/bge-reranker-v2-m3",
    "rerank_top_k": 5,
    "candidate_k": 20
  },
  "vector_store": {
      "persist_dir": "data/vector_store/first",
      "collection_name": "rag_documents",
      "batch_size": 100
  },
  "llm": {
    "model_name": "gemma4:latest",
    "base_url": "http://localhost:11434",
    "temperature": 0.1,
    "max_tokens": 1024
  },
  "evaluation": {
      "allowed_sources": ["text"],
      "eval_model": "gemma4:latest",
      "meta_dir":    "data/raw/metadata/pdf/arxiv",
      "metrics_dir": "logs/eval",
      "qrels_path":  "data/raw/metadata/pdf/arxiv/qrels.json",
      "answers_path": "data/raw/metadata/pdf/arxiv/answers.json"
  }
}
